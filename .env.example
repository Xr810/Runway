# Copy to .env.local; never commit populated environment files.
DATABASE_URL=postgresql://runway:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/runway
APP_ORIGIN=http://localhost:3000
# Keep this stable across upgrades: sessions and AI run history use this identity.
OWNER_ID=owner
# Generate separate random secrets, at least 32 characters each.
SESSION_SECRET=
AI_SETTINGS_KEY=
# salt:scrypt_hash; see README for the local generator.
LOGIN_PASSWORD_HASH=
ATTACHMENTS_DIR=./data/attachments
SCHEDULER=off
# Optional: configure here or in the authenticated Settings page.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
TAVILY_API_KEY=
