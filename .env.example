# Copy to .env.local; never commit populated environment files.
DATABASE_URL=postgresql://runway:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/runway
APP_ORIGIN=http://localhost:3000
# Generate separate random secrets, at least 32 characters each.
SESSION_SECRET=
AI_SETTINGS_KEY=
ATTACHMENTS_DIR=./data/attachments
SCHEDULER=off
# Optional Google OAuth. Authorize: ${APP_ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# personal: each permitted account supplies its own settings; environment AI keys are ignored.
# managed: permitted accounts use only the deployment configuration below and cannot edit it.
AI_MODE=personal
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
TAVILY_API_KEY=
